+    #[test]
+    fn cancelled_header_and_pixel_reads_are_retryable() {
+        for partial in [b"{".to_vec(), b"{\"ok\":true,\"time\":\"37\",\"bytes\":8}\n\0\0\0\0".to_vec()] {
+            let listener = TcpListener::bind((Ipv4Addr::LOCALHOST, 0)).unwrap();
+            let host = Host { port: listener.local_addr().unwrap().port(), token: "a".repeat(64) };
+            let source = Source { host, id: "test-source".into(), info: serde_json::from_value(info()).unwrap() };
+            let flag = Arc::new(AtomicBool::new(false));
+            let cancel = flag.clone();
+            let (release, wait) = std::sync::mpsc::channel();
+            let worker = std::thread::spawn(move || {
+                let (mut stream, _) = listener.accept().unwrap();
+                let mut line = String::new();
+                BufReader::new(stream.try_clone().unwrap()).read_line(&mut line).unwrap();
+                stream.write_all(&partial).unwrap();
+                cancel.store(true, Ordering::Relaxed);
+                // Leave the response incomplete until the caller notices cancellation.
+                wait.recv_timeout(Duration::from_secs(3)).unwrap();
+                drop(stream);
+                let (mut retry, _) = listener.accept().unwrap();
+                BufReader::new(retry.try_clone().unwrap()).read_line(&mut String::new()).unwrap();
+                retry.write_all(b"{\"ok\":true,\"time\":\"37\",\"bytes\":8}\n").unwrap();
+                retry.write_all(&[255; 8]).unwrap();
+            });
+            let result = filmcraft_media::cancel::with_cancel(&flag, || source.video_frame(FrameRequest::full(Tick(37))));
+            release.send(()).unwrap();
+            let retry = source.video_frame(FrameRequest::full(Tick(37))).unwrap();
+            worker.join().unwrap();
+            assert!(matches!(result, Err(MediaError::Cancelled)), "expected cancellation, got {result:?}");
+            assert_eq!(retry.pts, Tick(37));
+        }
+    }
