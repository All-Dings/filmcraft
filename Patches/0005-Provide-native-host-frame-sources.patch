+//! Optional native host frames. The launcher supplies a loopback port and credential through
+//! the environment. Files contain only an opaque source id, never endpoints or credentials.
+//! The host owns preparation and persistence. FilmCraft asks for exact media ticks on demand.
+use std::io::{self, BufRead, BufReader, Read, Write};
+use std::net::{Ipv4Addr, SocketAddr, TcpStream};
+use std::sync::{Arc, OnceLock};
+use std::time::{Duration, Instant};
+
+use filmcraft_frame::{AudioBuffer, VideoFrame};
+use filmcraft_media::{FrameRequest, MediaError, MediaInfo, MediaSource, Result, SharedReader, SharedSource};
+use serde_json::{Value, json};
+
+const MAGIC: &[u8] = b"FilmCraft Native Frames 1\n";
+const HEADER_LIMIT: u64 = 16 * 1024;
+const TIMEOUT: Duration = Duration::from_secs(30);
+static HOST: OnceLock<Host> = OnceLock::new();
+
+#[derive(Clone)]
+struct Host {
+    port: u16,
+    token: String,
+}
+
+pub fn install() {
+    let port = std::env::var("FILMCRAFT_FRAMES_PORT").ok().and_then(|v| v.parse::<u16>().ok()).filter(|p| *p > 0);
+    let token = std::env::var("FILMCRAFT_FRAMES_TOKEN").ok().filter(|v| v.len() == 64 && v.bytes().all(|b| b.is_ascii_hexdigit()));
+    if let (Some(port), Some(token)) = (port, token) {
+        let _ = HOST.set(Host { port, token });
+        filmcraft_codecs::register_reader_opener(open);
+    }
+}
+
+fn error(message: impl ToString) -> MediaError {
+    MediaError::Decode(format!("native host frames: {}", message.to_string()))
+}
+
+fn io_error(cause: io::Error) -> MediaError {
+    // Playback routinely supersedes in-flight reads. Reporting them as decode failures
+    // makes the monitor count healthy sources as damaged and display an unreadable slate.
+    if filmcraft_media::cancel::cancelled() { MediaError::Cancelled } else { error(cause) }
+}
+
+// Poll cancellation even while a host renders, and bound total time rather than only inactivity.
+struct Connection {
+    stream: TcpStream,
+    deadline: Instant,
+}
+impl Read for Connection {
+    fn read(&mut self, buffer: &mut [u8]) -> io::Result<usize> {
+        loop {
+            if filmcraft_media::cancel::cancelled() {
+                return Err(io::Error::other("cancelled"));
+            }
+            if Instant::now() >= self.deadline {
+                return Err(io::Error::new(io::ErrorKind::TimedOut, "host frame timeout"));
+            }
+            match self.stream.read(buffer) {
+                Err(e) if matches!(e.kind(), io::ErrorKind::TimedOut | io::ErrorKind::WouldBlock) => continue,
+                result => return result,
+            }
+        }
+    }
+}
+impl Host {
+    fn request(&self, source: &str, time: Option<i64>) -> Result<(Value, BufReader<Connection>)> {
+        let deadline = Instant::now() + TIMEOUT;
+        let request = match time {
+            Some(t) => json!({"token": self.token, "source": source, "method": "frame", "time": t.to_string()}),
+            None => json!({"token": self.token, "source": source, "method": "describe"}),
+        };
+        loop {
+            if filmcraft_media::cancel::cancelled() {
+                return Err(MediaError::Cancelled);
+            }
+            if Instant::now() >= deadline {
+                return Err(error("host frame timeout"));
+            }
+            let address = SocketAddr::from((Ipv4Addr::LOCALHOST, self.port));
+            let mut stream = TcpStream::connect_timeout(&address, Duration::from_secs(2)).map_err(io_error)?;
+            stream.set_write_timeout(Some(Duration::from_secs(2))).map_err(io_error)?;
+            stream.set_read_timeout(Some(Duration::from_millis(200))).map_err(io_error)?;
+            writeln!(stream, "{request}").map_err(io_error)?;
+            let mut reader = BufReader::new(Connection { stream, deadline });
+            let mut header = Vec::new();
+            reader.by_ref().take(HEADER_LIMIT + 1).read_until(b'\n', &mut header).map_err(io_error)?;
+            if filmcraft_media::cancel::cancelled() {
+                return Err(MediaError::Cancelled);
+            }
+            if header.len() as u64 > HEADER_LIMIT || header.last() != Some(&b'\n') {
+                return Err(error("invalid response header"));
+            }
+            let response: Value = serde_json::from_slice(&header).map_err(error)?;
+            if response["ok"] != true {
+                if response["busy"] == true {
+                    // A full host queue is not damaged media. Retry within the original
+                    // deadline, yielding promptly when playback supersedes this request.
+                    drop(reader);
+                    std::thread::sleep(Duration::from_millis(50));
+                    continue;
+                }
+                return Err(error(response["error"].as_str().unwrap_or("host unavailable")));
+            }
+            return Ok((response, reader));
+        }
+    }
+
+    fn source(&self, id: &str) -> Result<Source> {
+        let (response, _) = self.request(id, None)?;
+        let info: MediaInfo = serde_json::from_value(response["info"].clone()).map_err(error)?;
+        let v = info.video.as_ref().ok_or_else(|| error("video stream required"))?;
+        if !(1..=8192).contains(&v.width)
+            || !(1..=8192).contains(&v.height)
+            || u64::from(v.width) * u64::from(v.height) > 33_554_432
+            || !(1..=9_007_199_254_740_991).contains(&info.duration.0)
+            || !info.audio_streams.is_empty()
+            || !(1..=120_000).contains(&v.frame_rate.num)
+            || !(1..=10_000).contains(&v.frame_rate.den)
+            || v.par != (1, 1)
+            || v.pixel_format != "rgba8"
+        {
+            return Err(error("invalid source description"));
+        }
+        Ok(Source { host: self.clone(), id: id.into(), info })
+    }
+}
+
+fn open(_name: &str, head: &[u8], reader: &SharedReader) -> Option<Result<SharedSource>> {
+    let id = head.strip_prefix(MAGIC)?;
+    Some((|| {
+        if reader.len() != (MAGIC.len() + 32) as u64 || id.len() != 32 || !id.iter().all(u8::is_ascii_hexdigit) {
+            return Err(error("invalid source descriptor"));
+        }
+        let host = HOST.get().ok_or_else(|| error("no embedding host"))?;
+        let source = host.source(std::str::from_utf8(id).map_err(error)?)?;
+        Ok(Arc::new(source) as SharedSource)
+    })())
+}
+
+struct Source {
+    host: Host,
+    id: String,
+    info: MediaInfo,
+}
+impl MediaSource for Source {
+    fn info(&self) -> &MediaInfo {
+        &self.info
+    }
+
+    fn video_frame(&self, request: FrameRequest) -> Result<Arc<VideoFrame>> {
+        if request.time.0 < 0 || request.time >= self.info.duration {
+            return Err(error("frame outside source interval"));
+        }
+        let v = self.info.video.as_ref().ok_or_else(|| error("missing video stream"))?;
+        let size = u64::from(v.width) * u64::from(v.height) * 4;
+        let (header, mut reader) = self.host.request(&self.id, Some(request.time.0))?;
+        if header["bytes"].as_u64() != Some(size) || header["time"].as_str() != Some(&request.time.0.to_string()) {
+            return Err(error("incorrect frame time or byte count"));
+        }
+        let mut pixels = vec![0; size as usize];
+        reader.read_exact(&mut pixels).map_err(io_error)?;
+        if filmcraft_media::cancel::cancelled() {
+            return Err(MediaError::Cancelled);
+        }
+        Ok(Arc::new(VideoFrame::rgba8(v.width, v.height, pixels).with_pts(request.time)))
+    }
+
+    fn audio(&self, _start: i64, _frames: usize, _rate: u32) -> Result<AudioBuffer> {
+        Err(MediaError::NoStream("audio"))
+    }
+}
+
