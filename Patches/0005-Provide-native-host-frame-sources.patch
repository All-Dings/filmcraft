+/// Host-produced pictures may take longer than a display interval. Finish a coherent
+/// picture before catching up, as for asynchronous browser sources.
+pub fn coherent_playback(project: &Project) -> bool {
+    cfg!(target_arch = "wasm32")
+        || project.items.values().any(|item| {
+            matches!(&item.kind, filmcraft_project::ItemKind::Media(media)
+                if matches!(&media.media, filmcraft_project::MediaRef::File { path }
+                    if std::path::Path::new(path).extension().is_some_and(|ext| ext == "fcframes")))
+        })
+}
