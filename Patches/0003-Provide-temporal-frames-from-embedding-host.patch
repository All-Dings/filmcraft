+// Synthetic asynchronous sources: no media files or embedding adapter required.
+export async function runHostPlaybackTest(win = window) {
+    const api = win.filmcraft, wait = ms => new Promise(resolve => setTimeout(resolve, ms));
+    const check = (ok, message) => { if (!ok) throw new Error(message); };
+    const info = {name:'Delayed', kind:'Movie', duration:30*254016000000,
+        video:{width:160,height:90,frame_rate:{num:30,den:1},par:[1,1],codec:'host-rgba',pixel_format:'rgba8',
+            color:{matrix:'Bt709',transfer:'Srgb',primaries:'Bt709',range:'Full'},has_alpha:true,bitrate:null},
+        audio_streams:[],container:'host-frames',start_timecode:null,file_size:null};
+    // Two laps with a video, track, two speedometers and a plot need ten sources.
+    const capacity = [];
+    try {
+        for (let i=0;i<64;i++) capacity.push(api.provideFrames({info,read:()=>new win.Uint8Array(160*90*4)}));
+        check(api.frameSources().length===64, '64 sources were not registered');
+        let rejected=false;
+        try { api.provideFrames({info,read:()=>new win.Uint8Array(160*90*4)}); } catch(error) {
+            rejected=String(error).includes('limit (64)');
+        }
+        check(rejected && api.frameSources().length===64, 'Source 65 must fail without changing registered sources');
+    } finally {
+        capacity.forEach(source=>api.closeFrames(source.handle));
+    }
+    check(api.frameSources().length===0, 'Closing sources did not release capacity');
+    const sources = [600,...Array(9).fill(30)].map((delay, index) => api.provideFrames({info, read:async ticks => {
+        await wait(delay);
+        const pixels = new win.Uint8Array(160*90*4);
+        const value = Number(BigInt(ticks)/8467200000n)%255;
+        for (let p=0;p<pixels.length;p+=4) pixels.set([value,index*60,100,128],p);
+        return pixels;
+    }}));
+    const project = {format:'filmcraft.project',schema_version:15,generator:'Host playback regression',project:{
+        name:'Delayed layers',settings:{renderer:'FilmCraft GPU Acceleration (wgpu)',video_display:'Timecode',audio_display_samples:true,
+            default_still_duration:1270080000000,default_transition_duration_frames:24,default_audio_transition_duration:254016000000},
+        root:{id:0,name:'Delayed layers',children:[{Item:1}]},next_id:32,notes:'Synthetic regression',items:{
+            '1':{id:1,name:'Delayed layers',label:'Forest',created:1,metadata:{},kind:{Sequence:{
+                settings:{width:160,height:90,frame_rate:info.video.frame_rate,par:[1,1],sample_rate:48000,drop_frame:false,preset:'Custom',
+                    audio_master:'Stereo',preview_codec:'ProRes 422',max_bit_depth:false,max_render_quality:false,working_space:'Rec. 709'},
+                video_tracks:[],audio_tracks:[],markers:[],mark_in:null,mark_out:null,work_area:null,start_timecode:0}}}}},
+        view:{open_sequences:[1],active_sequence:1,sequences:{}}};
+    sources.forEach((source,index) => {
+        const id=2+index*3;
+        project.project.root.children.push({Item:id});
+        project.project.items[id]={id,name:'Layer '+index,label:'Iris',created:id,metadata:{},kind:{Media:{
+            media:{File:{path:source.path}},info,interpret:{frame_rate:null,par:null,ignore_alpha:false,invert_alpha:false},
+            mark_in:null,mark_out:null,markers:[],offline:false,proxy:null}}};
+        project.project.items['1'].kind.Sequence.video_tracks.push({id:id+1,kind:'Video',name:'Layer '+index,
+            items:[{id:id+2,item:id,name:'Layer '+index,label:'Iris',start:0,duration:info.duration,source_in:0,
+                speed:1,reverse:false,enabled:true,effects:[],frame_hold:null,scale_to_frame:false}],
+            transitions:[],locked:false,sync_lock:true,enabled:true,muted:false,solo:false,channels:'Stereo',volume_db:0,pan:0});
+    });
+    const samples = async (speed) => {
+        await api.request('ui.playback',{action:'play',speed});
+        const frames=[];
+        for (let i=0;i<10;i++) {
+            await wait(700);
+            const stats=await api.execute('perf.stats',{});
+            check(stats.playback.playing, 'Playback stopped unexpectedly');
+            frames.push(stats.monitor.frame);
+        }
+        check(new Set(frames).size>=4, 'Pending source starved playback: '+frames);
+        check(frames.slice(1).every((f,i)=>speed>0?f>=frames[i]:f<=frames[i]), 'Displayed frames reversed direction: '+frames);
+        await api.request('ui.playback',{action:'stop'});
+        return frames;
+    };
+    const exact = async (frame) => {
+        const deadline=Date.now()+5000;
+        while(Date.now()<deadline) {
+            const {monitor}=await api.execute('perf.stats',{});
+            if (monitor.frame===monitor.playheadFrame && monitor.revision===monitor.projectRevision &&
+                (frame===undefined || monitor.frame===frame)) return monitor;
+            await wait(50);
+        }
+        throw new Error('Stopped/seek frame did not become exact');
+    };
+    try {
+        await api.openProject(new win.File([JSON.stringify(project)],'Delayed.fcproj'));
+        await exact(0);
