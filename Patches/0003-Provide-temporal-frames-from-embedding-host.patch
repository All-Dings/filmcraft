+//! Time-addressed RGBA frames supplied by the embedding host. No domain-specific graph code.
+use filmcraft_frame::{AudioBuffer, VideoFrame};
+use filmcraft_media::{FrameRequest, MediaError, MediaInfo, MediaSource, SharedReader, SharedSource};
+use filmcraft_time::Tick;
+use serde_json::json;
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, HashMap};
+use std::sync::Arc;
+use wasm_bindgen::JsCast;
+use wasm_bindgen::prelude::*;
+use wasm_bindgen_futures::JsFuture;
+
+const MAGIC: &[u8] = b"FilmCraft Host Frames 1\n";
+// Complete host projects can contain up to 64 independently addressed layers.
+const MAX_SOURCES: usize = 64;
+const CACHE_BYTES: usize = 32 * 1024 * 1024;
+struct State {
+    info: MediaInfo,
+    read: js_sys::Function,
+    frames: BTreeMap<i64, Arc<VideoFrame>>,
+    pending: bool,
+    error: Option<String>,
+    reads: u64,
+}
+thread_local! {
+    static SOURCES: RefCell<HashMap<u32, State>> = RefCell::new(HashMap::new());
+    static NEXT: Cell<u32> = const { Cell::new(1) };
+}
+fn error(s: &str) -> JsValue {
+    js_sys::Error::new(s).into()
+}
+fn field(v: &JsValue, key: &str) -> Result<JsValue, JsValue> {
+    js_sys::Reflect::get(v, &key.into())
+}
+
+pub fn install(obj: &js_sys::Object) -> Result<(), JsValue> {
+    filmcraft_codecs::register_reader_opener(open);
+    let provide = Closure::<dyn Fn(JsValue) -> Result<JsValue, JsValue>>::new(|value: JsValue| {
+        let info: MediaInfo = serde_json::from_value(crate::api::from_js(&field(&value, "info")?)).map_err(|e| error(&e.to_string()))?;
+        let video = info.video.as_ref().ok_or_else(|| error("Expected video description"))?;
+        let pixels = u64::from(video.width) * u64::from(video.height);
+        if info.name.is_empty()
+            || info.name.len() > 256
+            || info.duration.0 <= 0
+            || info.duration.0 > 9_007_199_254_740_991
+            || pixels == 0
+            || pixels > 33_554_432
+            || video.width > 8192
+            || video.height > 8192
+            || video.frame_rate.num == 0
+            || video.frame_rate.den == 0
+            || video.frame_rate.num > 120_000
+            || video.frame_rate.den > 10_000
+            || !info.audio_streams.is_empty()
+            || video.pixel_format != "rgba8"
+            || video.par != (1, 1)
+        {
+            return Err(error("Invalid host frame description (RGBA8, <=32M pixels, sides <=8192, positive duration/rate, no audio)"));
+        }
+        let read = field(&value, "read")?.dyn_into::<js_sys::Function>()?;
+        let id = NEXT.with(|n| {
+            let id = n.get();
+            n.set(id.saturating_add(1));
+            id
+        });
+        SOURCES.with(|s| {
+            let mut s = s.borrow_mut();
+            if s.len() >= MAX_SOURCES || id == u32::MAX {
+                return Err(error("Host frame source limit (64) reached; close an existing source first"));
+            }
+            s.insert(id, State { info: info.clone(), read, frames: BTreeMap::new(), pending: false, error: None, reads: 0 });
+            Ok(())
+        })?;
+        let path = format!("/host-frames/{id}.fcframes");
+        let mut bytes = MAGIC.to_vec();
+        bytes.extend_from_slice(id.to_string().as_bytes());
+        crate::fs::put(&path, bytes);
+        Ok(crate::api::to_js(&json!({"path":path, "handle":id})))
+    });
+    js_sys::Reflect::set(obj, &"provideFrames".into(), &provide.into_js_value())?;
+    let close = Closure::<dyn Fn(u32)>::new(|id| {
+        SOURCES.with(|s| {
+            s.borrow_mut().remove(&id);
+        });
+        crate::repaint();
+    });
+    js_sys::Reflect::set(obj, &"closeFrames".into(), &close.into_js_value())?;
+    let stats = Closure::<dyn Fn() -> JsValue>::new(|| {
+        SOURCES.with(|s| {
+            crate::api::to_js(&json!(
+                s.borrow()
+                    .iter()
+                    .map(|(id, s)| json!({"handle":id,"reads":s.reads,"cached":s.frames.len(),"pending":s.pending,"error":s.error}))
+                    .collect::<Vec<_>>()
+            ))
+        })
+    });
+    js_sys::Reflect::set(obj, &"frameSources".into(), &stats.into_js_value())?;
+    Ok(())
+}
+fn open(_name: &str, head: &[u8], _reader: &SharedReader) -> Option<Result<SharedSource, MediaError>> {
+    let suffix = head.strip_prefix(MAGIC)?;
+    let result = || {
+        let id = std::str::from_utf8(suffix).ok().and_then(|s| s.parse::<u32>().ok()).ok_or_else(|| MediaError::Decode("Invalid host frame handle".into()))?;
+        let info = SOURCES
+            .with(|s| s.borrow().get(&id).map(|s| s.info.clone()))
+            .ok_or_else(|| MediaError::Offline("Host frame source is closed; reconnect it in the embedding host".into()))?;
+        Ok(Arc::new(Source { id, info }) as SharedSource)
+    };
+    Some(result())
+}
+struct Source {
+    id: u32,
+    info: MediaInfo,
+}
+impl MediaSource for Source {
+    fn info(&self) -> &MediaInfo {
+        &self.info
+    }
+    fn audio(&self, _: i64, _: usize, _: u32) -> Result<AudioBuffer, MediaError> {
+        Err(MediaError::NoStream("audio"))
+    }
+    fn video_frame(&self, req: FrameRequest) -> Result<Arc<VideoFrame>, MediaError> {
+        if req.time.0 < 0 || req.time >= self.info.duration {
+            return Err(MediaError::Decode("Host frame time is outside source duration".into()));
+        }
+        SOURCES.with(|sources| {
+            let mut sources = sources.borrow_mut();
+            let s = sources.get_mut(&self.id).ok_or_else(|| {
+                filmcraft_media::pending::mark();
+                MediaError::Offline("Host frame source closed".into())
+            })?;
+            if let Some(e) = &s.error {
+                // The compositor normally tolerates absent media. Never let an export
+                // commit a placeholder for a failed host frame; the host cancels it.
+                filmcraft_media::pending::mark();
+                return Err(MediaError::Decode(e.clone()));
+            }
+            if let Some(frame) = s.frames.get(&req.time.0) {
+                return Ok(frame.clone());
+            }
+            if !s.pending {
+                s.pending = true;
+                s.reads = s.reads.saturating_add(1);
+                let read = s.read.clone();
+                let id = self.id;
+                let time = req.time.0;
+                let video = s.info.video.as_ref().ok_or(MediaError::NoStream("video"))?;
+                let (w, h) = (video.width, video.height);
+                wasm_bindgen_futures::spawn_local(async move {
+                    let result = fetch(read, time, w, h).await;
+                    SOURCES.with(|sources| {
+                        let mut sources = sources.borrow_mut();
+                        // Removed handles are never reused: late replies cannot affect replacement sources.
+                        if let Some(s) = sources.get_mut(&id) {
+                            s.pending = false;
+                            match result {
+                                Ok(frame) => {
+                                    s.frames.insert(time, Arc::new(frame));
+                                    let limit = (CACHE_BYTES / (w as usize * h as usize * 4)).clamp(1, 64);
+                                    while s.frames.len() > limit {
+                                        let far = s.frames.keys().copied().max_by_key(|t| (i128::from(*t) - i128::from(time)).abs());
+                                        if let Some(t) = far {
+                                            s.frames.remove(&t);
+                                        } else {
+                                            break;
+                                        }
+                                    }
+                                }
+                                Err(e) => {
+                                    let reason =
+                                        e.as_string().or_else(|| field(&e, "message").ok().and_then(|v| v.as_string())).unwrap_or_else(|| format!("{e:?}"));
+                                    let message = format!("Host frame request failed: {reason}");
+                                    log::error!("{message}");
+                                    s.error = Some(message);
+                                }
+                            }
+                        }
+                    });
+                    crate::repaint();
+                });
+            }
+            filmcraft_media::pending::mark();
+            Err(MediaError::Decode("Host frame pending".into()))
+        })
+    }
+}
+async fn fetch(read: js_sys::Function, time: i64, w: u32, h: u32) -> Result<VideoFrame, JsValue> {
+    let request = read.call1(&JsValue::NULL, &time.to_string().into())?;
+    let window = web_sys::window().ok_or_else(|| error("No browser window"))?;
+    let mut callback = None;
+    let mut timer = None;
+    let timeout = js_sys::Promise::new(&mut |_, reject| {
+        let fail = reject.clone();
+        let closure = Closure::once(move || {
+            let _ = fail.call1(&JsValue::NULL, &error("Host frame timeout"));
+        });
+        match window.set_timeout_with_callback_and_timeout_and_arguments_0(closure.as_ref().unchecked_ref(), 15000) {
+            Ok(id) => timer = Some(id),
+            Err(e) => {
+                let _ = reject.call1(&JsValue::NULL, &e);
+            }
+        }
+        callback = Some(closure);
+    });
+    let promises = js_sys::Array::new();
+    promises.push(&js_sys::Promise::resolve(&request));
+    promises.push(&timeout);
+    let result = JsFuture::from(js_sys::Promise::race(&promises)).await;
+    if let Some(timer) = timer {
+        window.clear_timeout_with_handle(timer);
+    }
+    drop(callback);
+    let result = result?;
+    if !result.is_instance_of::<js_sys::Uint8Array>() || field(&result, "byteLength")?.as_f64() != Some(f64::from(w) * f64::from(h) * 4.0) {
+        return Err(error("Host frame must be an exact width*height*4 Uint8Array (straight RGBA8)"));
+    }
+    Ok(VideoFrame::rgba8(w, h, js_sys::Uint8Array::new(&result).to_vec()).with_pts(Tick(time)))
+}
