 /// A media source that times its `video_frame` calls (see [`JobRecord::source_wall`]).
-struct TimedSource(filmcraft_media::SharedSource);
+struct TimedSource(filmcraft_media::SharedSource, ItemId);
+
+/// The actual media demands of one completed frame, including hits in source caches.
+#[derive(Clone, Debug, Default)]
+pub struct SourceReads {
+    pub reads: Vec<(ItemId, Tick)>,
+    pub truncated: bool,
+    pub preview: bool,
+}
+
+impl SourceReads {
+    fn record(&mut self, item: ItemId, time: Tick) {
+        if self.reads.contains(&(item, time)) {
+            return;
+        }
+        if self.reads.len() >= 256 {
+            self.truncated = true;
+            return;
+        }
+        self.reads.push((item, time));
+    }
+}
+
+fn remember_source_reads(sh: &Shared, key: FrameKey, preview: bool) {
+    if !matches!(key.target, Target::Sequence(_) | Target::SequencePlan(_) | Target::SequenceLive(_)) {
+        return;
+    }
+    let mut reads = SOURCE_READS.with(|s| s.borrow().clone());
+    reads.preview = preview;
+    let mut cache = sh.source_reads.lock().unwrap_or_else(|e| e.into_inner());
+    cache.retain(|(k, _)| *k != key);
+    if cache.len() >= 256 {
+        cache.pop_front();
+    }
+    cache.push_back((key, reads));
+}
 
