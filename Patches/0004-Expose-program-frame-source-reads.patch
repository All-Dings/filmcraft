 #[test]
+fn program_source_reads_follow_the_picture_and_survive_cache_hits() {
+    let mut d = Driver::demo();
+    d.settled();
+    let first = d.ok("perf.stats", json!({}))["monitor"].clone();
+    assert!(!first["sourceReads"].as_array().unwrap().is_empty(), "{first}");
+    assert_eq!(first["sourceReadsTruncated"], json!(false));
+    assert_eq!(first["renderPreview"], json!(false));
+    d.exec("playhead.set", json!({"frame": 30}));
+    d.settled();
+    let second = d.ok("perf.stats", json!({}))["monitor"].clone();
+    assert_ne!(first["timeTicks"], second["timeTicks"]);
+    assert_ne!(first["sourceReads"], second["sourceReads"]);
+    d.exec("playhead.set", json!({"frame": first["frame"]}));
+    d.settled();
+    let cached = d.ok("perf.stats", json!({}))["monitor"].clone();
+    assert_eq!(first["sourceReads"], cached["sourceReads"]);
+    assert_eq!(first["timeTicks"], cached["timeTicks"]);
+}
